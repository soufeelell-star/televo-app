<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ghost"
    android:focusable="true"
    android:clickable="true"
    android:padding="13dp"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/ep_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_num" android:paddingHorizontal="11dp" android:paddingVertical="6dp"
        android:text="1" android:textColor="@color/tv_amber" android:textStyle="bold" android:fontFamily="monospace" android:textSize="13sp" />

    <TextView android:id="@+id/ep_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:text="Episode" android:textColor="@color/tv_text" android:textSize="15sp"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
