<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ============ LEFT: welcome + steps ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="72dp"
        android:paddingEnd="48dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <ImageView android:layout_width="250dp" android:layout_height="wrap_content" android:adjustViewBounds="true" android:src="@drawable/televo_lockup" android:contentDescription="@string/app_name" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp"
            android:fontFamily="@font/outfit" android:text="WELCOME" android:textColor="@color/tv_magenta"
            android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.2" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:fontFamily="@font/outfit" android:text="Log in to Televo" android:textColor="@color/tv_text"
            android:textSize="42sp" android:textStyle="bold" android:letterSpacing="-0.025" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:maxWidth="460dp" android:lineSpacingMultiplier="1.35"
            android:text="Choose your server, enter the username and password from your subscription, and your channels, movies and series load automatically."
            android:textColor="@color/tv_muted" android:textSize="16sp" />

        <!-- step 1 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="26dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="1" android:textColor="@color/tv_lavender" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pick your server" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select the server your provider gave you." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- step 2 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="2" android:textColor="@color/tv_lavender" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter your login" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type the username and password from your subscription." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- step 3 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="3" android:textColor="@color/tv_lavender" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start watching" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Press Log in and Televo opens instantly." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="@string/disclaimer" android:textColor="@color/tv_muted3" android:textSize="12.5sp" />
    </LinearLayout>

    <!-- divider -->
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/bg_divider_v" />

    <!-- ============ RIGHT: login card ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp">

        <LinearLayout android:layout_width="420dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="32dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:text="Sign in" android:textColor="@color/tv_text" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Free forever — no activation needed." android:textColor="@color/tv_muted" android:textSize="14sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:fontFamily="@font/outfit" android:text="SERVER" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <Spinner android:id="@+id/sp_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:padding="12dp" android:popupBackground="@color/tv_surface" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="@font/outfit" android:text="USERNAME" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <EditText android:id="@+id/in_user" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="15dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted2" android:hint="@string/username" android:inputType="text" android:maxLines="1" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="@font/outfit" android:text="PASSWORD" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <EditText android:id="@+id/in_pass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="15dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted2" android:hint="@string/password" android:inputType="text" android:maxLines="1" />

            <Button android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="@font/outfit" android:text="Log in" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp" android:textAllCaps="false" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:padding="16dp" />
            <TextView android:id="@+id/login_msg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="" android:textColor="@color/tv_amber" android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
