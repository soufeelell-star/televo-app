<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ============ LEFT ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="96dp"
        android:paddingEnd="64dp"
        android:paddingTop="56dp"
        android:paddingBottom="56dp">

        <ImageView android:layout_width="290dp" android:layout_height="wrap_content" android:adjustViewBounds="true" android:src="@drawable/televo_lockup" android:contentDescription="@string/app_name" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="34dp"
            android:fontFamily="@font/outfit" android:text="WELCOME" android:textColor="@color/tv_magenta"
            android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.2" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit" android:text="Activate your device" android:textColor="@color/tv_text"
            android:textSize="48sp" android:textStyle="bold" android:letterSpacing="-0.025" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:maxWidth="470dp" android:lineSpacingMultiplier="1.35"
            android:text="Sign in with the details from your Televo provider. Once connected, your channels, movies and series load automatically."
            android:textColor="@color/tv_muted" android:textSize="17sp" />

        <!-- step 1 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="34dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="1" android:textColor="@color/tv_accent" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter your details" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Type the username and password from your provider." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- step 2 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="2" android:textColor="@color/tv_accent" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pick your server" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Choose the host URL your provider gave you." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- step 3 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_step_num" android:fontFamily="@font/outfit" android:text="3" android:textColor="@color/tv_accent" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start watching" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Press Sign in and your playlist loads instantly." android:textColor="@color/tv_muted" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- divider -->
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/bg_divider_v" />

    <!-- ============ RIGHT (card) ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="56dp">

        <LinearLayout android:layout_width="440dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingHorizontal="38dp" android:paddingVertical="38dp">

            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:adjustViewBounds="true" android:src="@drawable/televo_mark" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="SIGN IN TO YOUR PLAYLIST" android:textColor="@color/tv_muted2" android:textSize="11.5sp" android:textStyle="bold" android:letterSpacing="0.18" />

            <!-- Username -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="USERNAME" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <EditText android:id="@+id/in_user" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:paddingHorizontal="18dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted3" android:hint="Your username" android:inputType="text" android:maxLines="1" android:fontFamily="@font/manrope" />

            <!-- Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="PASSWORD" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <EditText android:id="@+id/in_pass" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:paddingHorizontal="18dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted3" android:hint="Your password" android:inputType="textVisiblePassword" android:maxLines="1" android:fontFamily="@font/manrope" />

            <!-- Host URL -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="HOST URL" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <LinearLayout android:id="@+id/host_row" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:background="@drawable/bg_field" android:focusable="true" android:clickable="true">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/bg_dot_ok" />
                <TextView android:id="@+id/host_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="—" android:textColor="@color/tv_text" android:textStyle="bold" android:textSize="15.5sp" android:singleLine="true" android:ellipsize="end" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron" android:tint="@color/tv_muted" android:contentDescription="@null" />
            </LinearLayout>

            <!-- Sign in -->
            <LinearLayout android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="26dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_btn_primary" android:focusable="true" android:clickable="true">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_signin" android:tint="@color/white" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:fontFamily="@font/outfit" android:text="Sign in" android:textColor="@color/white" android:textStyle="bold" android:textSize="16.5sp" />
            </LinearLayout>

            <TextView android:id="@+id/login_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="" android:textColor="@color/tv_amber" android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
