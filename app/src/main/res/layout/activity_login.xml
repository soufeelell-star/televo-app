<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_televo" android:contentDescription="@string/app_name" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/app_name" android:textColor="@color/tv_text" android:textSize="30sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Log in with your subscription" android:textColor="@color/tv_muted" android:textSize="15sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="26dp" android:layout_marginTop="22dp" android:maxWidth="560dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" />
            <Spinner android:id="@+id/sp_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_field" android:padding="8dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/username" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" />
            <EditText android:id="@+id/in_user" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="14dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted" android:hint="@string/username" android:inputType="text" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/password" android:textColor="@color/tv_muted" android:textSize="12.5sp" android:textStyle="bold" />
            <EditText android:id="@+id/in_pass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="14dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted" android:hint="@string/password" android:inputType="text" />

            <Button android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Log in" android:textColor="@color/white" android:textStyle="bold" android:textAllCaps="false" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" />
            <TextView android:id="@+id/login_msg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textColor="@color/tv_amber" android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
