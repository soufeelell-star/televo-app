<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">

        <!-- Real Televo logo lockup -->
        <ImageView android:layout_width="240dp" android:layout_height="wrap_content" android:adjustViewBounds="true" android:src="@drawable/televo_lockup" android:contentDescription="@string/app_name" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="@font/outfit" android:text="Log in to watch" android:textColor="@color/tv_text" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="-0.02" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Choose your server and enter your username and password." android:textColor="@color/tv_muted" android:textSize="15sp" android:gravity="center" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="30dp" android:layout_marginTop="24dp" android:maxWidth="540dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:text="SERVER" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <Spinner android:id="@+id/sp_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:padding="10dp" android:popupBackground="@color/tv_surface" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="@font/outfit" android:text="USERNAME" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <EditText android:id="@+id/in_user" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="15dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted2" android:hint="@string/username" android:inputType="text" android:maxLines="1" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="@font/outfit" android:text="PASSWORD" android:textColor="@color/tv_muted2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <EditText android:id="@+id/in_pass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="15dp" android:background="@drawable/bg_field" android:textColor="@color/tv_text" android:textColorHint="@color/tv_muted2" android:hint="@string/password" android:inputType="text" android:maxLines="1" />

            <Button android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="@font/outfit" android:text="Log in" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp" android:textAllCaps="false" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:padding="16dp" />
            <TextView android:id="@+id/login_msg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="" android:textColor="@color/tv_amber" android:textSize="13.5sp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/disclaimer" android:textColor="@color/tv_muted3" android:textSize="12.5sp" android:gravity="center" />
    </LinearLayout>
</ScrollView>
