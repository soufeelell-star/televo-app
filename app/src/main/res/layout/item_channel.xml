<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ghost"
    android:focusable="true"
    android:clickable="true"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/ch_logo" android:layout_width="46dp" android:layout_height="46dp" android:gravity="center" android:text="TV" android:textColor="@color/tv_magenta" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/bg_field" />

    <TextView android:id="@+id/ch_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Channel" android:textColor="@color/tv_text" android:textSize="16sp" android:singleLine="true" android:ellipsize="end" />

    <TextView android:id="@+id/ch_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:text="0" android:textColor="@color/tv_amber" android:textStyle="bold" android:textSize="13sp" android:fontFamily="monospace" />
</LinearLayout>
