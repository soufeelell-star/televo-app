<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="48dp"
    android:gravity="center">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="30dp">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_televo" android:contentDescription="@string/app_name" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/app_name" android:textColor="@color/tv_text" android:textSize="30sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

        <LinearLayout android:id="@+id/tile_live" android:layout_width="200dp" android:layout_height="210dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile" android:focusable="true" android:clickable="true" android:layout_marginEnd="18dp">
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_live" android:contentDescription="@string/live_tv" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/live_tv" android:textColor="@color/tv_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tile_movies" android:layout_width="200dp" android:layout_height="210dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile" android:focusable="true" android:clickable="true" android:layout_marginEnd="18dp">
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_movies" android:contentDescription="@string/movies" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/movies" android:textColor="@color/tv_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tile_series" android:layout_width="200dp" android:layout_height="210dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile" android:focusable="true" android:clickable="true" android:layout_marginEnd="18dp">
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_series" android:contentDescription="@string/series" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/series" android:textColor="@color/tv_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tile_radio" android:layout_width="200dp" android:layout_height="210dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile" android:focusable="true" android:clickable="true">
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_radio" android:contentDescription="@string/radio" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/radio" android:textColor="@color/tv_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
