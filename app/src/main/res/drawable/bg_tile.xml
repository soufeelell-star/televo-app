<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="linear" android:angle="270" android:startColor="#FF1B2438" android:endColor="#FF0C1220" />
            <stroke android:width="3dp" android:color="#FFC77BF0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="linear" android:angle="270" android:startColor="#FF1B2438" android:endColor="#FF0C1220" />
            <stroke android:width="3dp" android:color="#FFC77BF0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="linear" android:angle="270" android:startColor="#FF141B2B" android:endColor="#FF0C1220" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</selector>
